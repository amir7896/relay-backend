NODE_ENV=development

# API Gateway
GATEWAY_PORT=3002
GATEWAY_GLOBAL_PREFIX=api
SWAGGER_ENABLED=true
CORS_ORIGIN=*

# Auth / User / Chat HTTP health ports
AUTH_HTTP_PORT=3001
USER_HTTP_PORT=3003
CHAT_HTTP_PORT=3004

# JWT
JWT_ACCESS_SECRET=change-this-access-secret-min-16
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-this-refresh-secret-min-16
JWT_REFRESH_EXPIRES_IN=7d

# Bootstrap admin (auth-service). Register always creates role=user.
# If the email already exists it is promoted. If not, ADMIN_PASSWORD is required.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin!Pass123

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nest
POSTGRES_PASSWORD=nest
AUTH_POSTGRES_DATABASE=nest_auth
USER_POSTGRES_DATABASE=nest_users
CHAT_POSTGRES_DATABASE=nest_chat

# RabbitMQ (API gateway <-> microservice transport)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=nest
RABBITMQ_PASSWORD=nest
RABBITMQ_VHOST=/

# Redis (gateway cache and access-token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL_SECONDS=60
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60

# Optional — AI thread summaries (OpenAI). Without this, heuristic summaries are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# File storage for chat images / voice notes (API Gateway)
# Drivers: local (default) | s3 | cloudinary
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

# S3 / S3-compatible (MinIO, R2, DigitalOcean Spaces, etc.)
# STORAGE_DRIVER=s3
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=relay-uploads
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_ENDPOINT=                 # optional; set for MinIO/R2/Spaces
# STORAGE_S3_PUBLIC_URL=               # optional CDN / public base URL
# STORAGE_S3_FORCE_PATH_STYLE=false    # true for many MinIO setups
# STORAGE_S3_PREFIX=relay

# Cloudinary — voice notes saved as relay/{userName}/voiceNotes/{id}
# STORAGE_DRIVER=cloudinary
# STORAGE_CLOUDINARY_CLOUD_NAME=
# STORAGE_CLOUDINARY_API_KEY=
# STORAGE_CLOUDINARY_API_SECRET=
# STORAGE_CLOUDINARY_FOLDER=relay

# Public app URL (invite / reset / verify email links)
APP_PUBLIC_URL=http://127.0.0.1:5173

# Optional SMTP (without SMTP_HOST, links are logged to the auth-service console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Relay <noreply@example.com>"

# Browser Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Scale / performance (safe defaults for local; raise in production)
# GATEWAY_MAX_INFLIGHT is max concurrent RabbitMQ round-trips; extra requests wait in line (no 503).
GATEWAY_TIMEOUT_MS=10000
GATEWAY_MAX_INFLIGHT=2000
GATEWAY_WORKERS=1
AUTH_VALIDATE_CACHE_SECONDS=15
RABBITMQ_PREFETCH=16
POSTGRES_POOL_MAX=20
POSTGRES_POOL_MIN=2

# WebRTC voice calls (STUN defaults; optional TURN for production NATs)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# WEBRTC_TURN_URLS=turn:turn.example.com:3478
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=
