{
  "name": "nestjs-micro-services",
  "version": "1.1.0",
  "description": "Production-grade NestJS microservices platform with API Gateway, Auth, Users, PostgreSQL, TypeORM, RabbitMQ, Redis, and Swagger",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build api-gateway && nest build auth-service && nest build user-service && nest build chat-service",
    "build:gateway": "nest build api-gateway",
    "build:auth": "nest build auth-service",
    "build:users": "nest build user-service",
    "build:chat": "nest build chat-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:gateway": "nest start api-gateway --watch",
    "start:auth": "nest start auth-service --watch",
    "start:users": "nest start user-service --watch",
    "start:chat": "nest start chat-service --watch",
    "start:dev": "concurrently -n gateway,auth,users,chat -c blue,green,magenta,cyan \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:users\" \"npm run start:chat\"",
    "start:frontend": "npm --prefix ../frontend run dev",
    "start:gateway:prod": "node dist/apps/api-gateway/main",
    "start:auth:prod": "node dist/apps/auth-service/main",
    "start:users:prod": "node dist/apps/user-service/main",
    "start:chat:prod": "node dist/apps/chat-service/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "typeorm:auth": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/auth-service/src/database/data-source.ts",
    "typeorm:users": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/user-service/src/database/data-source.ts",
    "typeorm:chat": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/chat-service/src/database/data-source.ts",
    "migration:auth:generate": "npm run typeorm:auth -- migration:generate",
    "migration:auth:create": "npm run typeorm:auth -- migration:create",
    "migration:auth:run": "npm run typeorm:auth -- migration:run",
    "migration:auth:revert": "npm run typeorm:auth -- migration:revert",
    "migration:auth:show": "npm run typeorm:auth -- migration:show",
    "migration:users:generate": "npm run typeorm:users -- migration:generate",
    "migration:users:create": "npm run typeorm:users -- migration:create",
    "migration:users:run": "npm run typeorm:users -- migration:run",
    "migration:users:revert": "npm run typeorm:users -- migration:revert",
    "migration:users:show": "npm run typeorm:users -- migration:show",
    "migration:chat:generate": "npm run typeorm:chat -- migration:generate",
    "migration:chat:create": "npm run typeorm:chat -- migration:create",
    "migration:chat:run": "npm run typeorm:chat -- migration:run",
    "migration:chat:revert": "npm run typeorm:chat -- migration:revert",
    "migration:chat:show": "npm run typeorm:chat -- migration:show",
    "migration:run": "npm run migration:auth:run && npm run migration:users:run && npm run migration:chat:run",
    "docker:up": "docker compose up -d",
    "docker:up:all": "docker compose --profile full up -d",
    "docker:down": "docker compose --profile full down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.2.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.2.3",
    "@node-saml/node-saml": "^5.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.2",
    "joi": "^18.2.5",
    "jose": "^5.10.0",
    "keyv": "^5.6.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.2",
    "typeorm": "^1.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1"
    }
  }
}
